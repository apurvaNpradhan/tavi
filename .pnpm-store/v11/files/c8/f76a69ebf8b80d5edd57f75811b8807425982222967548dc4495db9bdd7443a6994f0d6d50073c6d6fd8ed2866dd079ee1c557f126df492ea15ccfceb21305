string>\n}\n\nexport function A11yIssueList(props: A11yIssueListProps) {\n  const [selectedIssueId, setSelectedIssueId] = props.selectedIssueSignal\n\n  // hooks\n  const styles = createStyles()\n  const ally = createAllyContext()\n\n  // handlers\n  const handleIssueClick = (issueId: string) => {\n    if (selectedIssueId() === issueId) {\n      setSelectedIssueId('')\n      clearHighlights()\n\n      if (\n        ally.config.showOverlays &&\n        ally.allyResult.audit &&\n        ally.filteredIssues().length > 0\n      ) {\n        highlightAllIssues(ally.filteredIssues(), ally.theme())\n      }\n\n      return\n    }\n\n    setSelectedIssueId(issueId)\n    clearHighlights()\n\n    const issue = ally.allyResult.audit?.issues.find((i) => i.id === issueId)\n    if (!issue || issue.nodes.length === 0) return\n\n    let scrolled = false\n    for (const node of issue.nodes) {\n      const selector = node.selector\n      if (!selector) continue\n\n      try {\n        const el = document.querySelector(selector)\n        if (el) {\n          if (!scrolled) {\n            scrollToElement(selector)\n            scrolled = true\n          }\n\n          highlightElement(selector, issue.impact, {\n            showTooltip: true,\n            ruleId: issue.ruleId,\n            theme: ally.theme(),\n          })\n        }\n      } catch (error) {\n        console.warn('[A11y Panel] Invalid selector:', selector, error)\n      }\n    }\n  }\n\n  return (\n    <div data-tsd-surface>\n      <div class={styles().summaryGrid} data-tsd-surface>\n        <For each={IMPACTS}>\n          {(impact) => {\n            // Count issues from the reactive filteredIssues memo so counts update when config.threshold changes\n            const issuesForImpact = () =>\n              ally.filteredIssues().filter((issue) => issue.impact === impact)\n            const count = () => issuesForImpact().length || 0\n\n            const active = () => ally.impactKey() === impact\n\n            return (\n              <button\n                data-tsd-control\n                data-tsd-selected={active() ? 'true' : undefined}\n                class={styles().summaryButton}\n                classList={{\n                  [styles().summaryButtonActive(impact)]: active(),\n                }}\n                onClick={() => {\n                  ally.setImpactKey(\n                    ally.impactKey() === impact ? 'all' : impact,\n                  )\n\n                  setSelectedIssueId('')\n                }}\n              >\n                <div class={styles().summaryCount(impact)}>{count()}</div>\n                <div class={styles().summaryLabel}>\n                  {SEVERITY_LABELS[impact]}\n                </div>\n              </button>\n            )\n          }}\n        </For>\n      </div>\n\n      <For each={IMPACTS}>\n        {(impact) => {\n          const issues = () =>\n            ally.filteredIssues().filter((issue) => issue.impact === impact)\n\n          const shouldRender = () => {\n            if (ally.impactKey() !== 'all') {\n              return ally.impactKey() === impact\n            }\n            return issues().length > 0\n          }\n\n          return (\n            <Show when={shouldRender()}>\n              <div class={styles().section} data-tsd-surface data-tsd-separator>\n                <h3 class={styles().sectionTitle(impact)}>\n                  {SEVERITY_LABELS[impact]} ({issues().length})\n                </h3>\n\n                <For each={issues()}>\n                  {(issue) => (\n                    <A11yIssueCard\n                      issue={issue}\n                      impact={impact}\n                      selected={selectedIssueId() === issue.id}\n                      onSelect={() => handleIssueClick(issue.id)}\n                      onDisableRule={() =>\n                        ally.setConfig('disabledRules', [\n                          ...ally.config.disabledRules,\n                          issue.ruleId,\n                        ])\n                      }\n                    />\n                  )}\n                </For>\n              </div>\n            </Show>\n          )\n        }}\n      </For>\n    </div>\n  )\n}\n"],"mappings":";;;;;;;;;;AAsBA,SAAgBc,cAAcC,OAA2B;CACvD,MAAM,CAACC,iBAAiBC,sBAAsBF,MAAMF;CAGpD,MAAMK,SAAST,cAAc;CAC7B,MAAMU,OAAOjB,mBAAmB;CAGhC,MAAMkB,oBAAoBC,YAAoB;EAC5C,IAAIL,iBAAiB,KAAKK,SAAS;GACjCJ,mBAAmB,GAAG;GACtBb,iBAAiB;GAEjB,IACEe,KAAKG,OAAOC,gBACZJ,KAAKK,WAAWC,SAChBN,KAAKO,gBAAgB,CAACC,SAAS,GAE/BtB,mBAAmBc,KAAKO,gBAAgB,EAAEP,KAAKS,OAAO,CAAC;GAGzD;;EAGFX,mBAAmBI,QAAQ;EAC3BjB,iBAAiB;EAEjB,MAAMyB,QAAQV,KAAKK,WAAWC,OAAOK,OAAOC,MAAMC,MAAMA,EAAEC,OAAOZ,QAAQ;EACzE,IAAI,CAACQ,SAASA,MAAMK,MAAMP,WAAW,GAAG;EAExC,IAAIQ,WAAW;EACf,KAAK,MAAMC,QAAQP,MAAMK,OAAO;GAC9B,MAAMG,WAAWD,KAAKC;GACtB,IAAI,CAACA,UAAU;GAEf,IAAI;IAEF,IADWE,SAASC,cAAcH,SAC9BC,EAAI;KACN,IAAI,CAACH,UAAU;MACb5B,gBAAgB8B,SAAS;MACzBF,WAAW;;KAGb7B,iBAAiB+B,UAAUR,MAAMY,QAAQ;MACvCC,aAAa;MACbC,QAAQd,MAAMc;MACdf,OAAOT,KAAKS,OAAM;MACnB,CAAC;;YAEGgB,OAAO;IACdC,QAAQC,KAAK,kCAAkCT,UAAUO,MAAM;;;;CAKrE,cAAA;EAAA,IAAAG,OAAAC,eAAAC,OAAA,EAAAC,QAAAH,KAAAI,YAAAC,QAAAF,MAAAG,aAAA,CAAAC,OAAAC,QAAAC,cAAAJ,MAAAC,YAAA;EAAAI,OAAAP,OAAAQ,gBAGO1D,KAAG;GAAC2D,MAAMnD;GAAOoD,WACdnB,WAAW;IAEX,MAAMoB,wBACJ1C,KAAKO,gBAAgB,CAACoC,QAAQjC,UAAUA,MAAMY,WAAWA,OAAO;IAClE,MAAMsB,cAAcF,iBAAiB,CAAClC,UAAU;IAEhD,MAAMqC,eAAe7C,KAAK8C,WAAW,KAAKxB;IAE1C,cAAA;KAAA,IAAAyB,QAAAlB,eAAAmB,QAAA,EAAAC,QAAAF,MAAAf,YAAAkB,QAAAD,MAAAf;KAAAa,MAAAI,gBAQmB;MACbnD,KAAKoD,aACHpD,KAAK8C,WAAW,KAAKxB,SAAS,QAAQA,OACvC;MAEDxB,mBAAmB,GAAG;;KACvBwC,OAAAW,OAE2CL,MAAK;KAAAN,OAAAY,aAE9ClE,gBAAgBsC,QAAO;KAAA+B,QAAAC,QAAA;MAAA,IAAAC,MAfPV,QAAQ,GAAG,SAASW,KAAAA,GAASC,OACzC1D,QAAQ,CAAC2D,eAAaC,OAClB,GACR5D,QAAQ,CAAC6D,oBAAoBtC,OAAO,GAAGuB,QAAO,EAChD,EAAAgB,OASW9D,QAAQ,CAAC+D,aAAaxC,OAAO,EAAAyC,OAC7BhE,QAAQ,CAACiE;MAAYT,QAAAD,IAAAW,KAAAC,aAAAnB,OAAA,qBAAAO,IAAAW,IAAAV,IAAA;MAAAE,SAAAH,IAAAa,KAAAC,UAAArB,OAAAO,IAAAa,IAAAV,KAAA;MAAAH,IAAAe,IAAAC,UAAAvB,OAAAY,MAA