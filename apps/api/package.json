{
  "name": "@tavi/api",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./dist/router.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/router.ts --bundle --platform=node --outdir=dist --format=esm --packages=external",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "~1.6.33",
    "@better-auth/drizzle-adapter": "~1.6.33",
    "@better-auth/expo": "~1.6.33",
    "@tavi/email": "workspace:*",
    "@tavi/env": "workspace:*",
    "@tavi/permissions": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^1.6.1",
    "@orpc/json-schema": "2.0.0-beta.40",
    "@orpc/openapi": "2.0.0-beta.40",
    "@orpc/server": "2.0.0-beta.40",
    "@orpc/zod": "2.0.0-beta.40",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/hono-api-reference": "^0.12.4",
    "@sentry/node": "^11.0.0",
    "@sentry/profiling-node": "^10.70.0",
    "better-auth": "~1.6.33",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tavi/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
