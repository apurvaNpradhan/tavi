# apps/api/.env.sample — API server configuration.
#
# Copy to apps/api/.env for local development:
#   cp apps/api/.env.sample apps/api/.env
# Loaded by @tavi/env/server (dotenv reads .env from the process working
# directory — under pnpm/turbo that is apps/api). The root .env is reserved for
# Docker Compose services only.

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
TAVI_API_URL=http://localhost:1337
TAVI_CLIENT_URL=http://localhost:5173
TAVI_APP_NAME=Tavi
# CORS_ORIGINS=                                    # comma-separated; defaults to TAVI_CLIENT_URL
# PORT=1337

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set DATABASE_URL, or derive one from the POSTGRES_* values below (only used
# when POSTGRES_PASSWORD/POSTGRES_HOST/POSTGRES_PORT is set).
DATABASE_URL=postgresql://tavi:tavi@localhost:5432/tavi
# POSTGRES_DB=tavi
# POSTGRES_USER=tavi
# POSTGRES_PASSWORD=tavi
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# In development a missing AUTH_SECRET generates one and persists it to
# .auth-secret, so restarts keep working. Production requires a real value.
# Generate with: openssl rand -hex 32
# AUTH_SECRET=

# Social sign-in (optional; leave empty to hide the provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generic OIDC provider (optional)
CUSTOM_OAUTH_CLIENT_ID=
CUSTOM_OAUTH_CLIENT_SECRET=
CUSTOM_OAUTH_DISCOVERY_URL=

# Feature switches
# DISABLE_REGISTRATION=false
# DISABLE_LOGIN_FORM=false
# DISABLE_EMAIL_OTP_SIGN_IN=false
# DISABLE_WORKSPACE_CREATION=false
# DISABLE_GUEST_ACCESS=false
# DEVICE_AUTH_CLIENT_IDS=callus-cli
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Email (optional; invitation emails and account deletion need it)
# This configures outbound email, not in-app notification delivery.
# Resend API key and a from-address on a domain verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Observability (optional; nothing is reported without a DSN)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=