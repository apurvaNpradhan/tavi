# Use the API address reachable from this device. Android emulator: 10.0.2.2.
# For a physical device, use your computer's LAN address (for example, 192.168.1.25).
EXPO_PUBLIC_API_URL=http://localhost:1337

# Browser destination for settings not included in the native first release.
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Optional public Sentry DSN. Leave empty to disable native reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only. Set outside the app bundle to upload production source maps.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
