{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/routeTree.gen.ts",
    "apps/api/drizzle/**",
    "tools/oxlint/anti-slop/**",
    ".agents/**",
    "repos/**",
    "openapi.json",
    "pnpm-lock.yaml",
    "**/.env*",
    "**/.auth-secret"
  ]
}
