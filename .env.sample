# Root .env.sample — Docker Compose services only.
#
# Copy to .env for `docker compose` (compose.yml with bundled Postgres, or
# compose.dokploy.yml with an external DATABASE_URL).
#
# Application variables do NOT live here. They are split per app:
#   - apps/api/.env.sample  → API server configuration
#   - apps/web/.env.development → Vite configuration (committed; VITE_* vars)

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Public origin the browser uses; both TAVI_CLIENT_URL and TAVI_API_URL
# are derived from it by compose.yml / compose.dokploy.yml. Using one origin
# keeps session cookies first-party (SameSite=Lax) instead of cross-site.
TAVI_PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Database (bundled compose.yml only)
# ---------------------------------------------------------------------------
# compose.dokploy.yml does not run Postgres: it reads DATABASE_URL instead,
# pointing at a separate managed PostgreSQL service.
POSTGRES_DB=tavi
POSTGRES_USER=tavi
POSTGRES_PASSWORD=tavi

# ---------------------------------------------------------------------------
# Authentication (required in production)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Email (optional; invitation emails and account deletion need it)
# This configures outbound email, not in-app notification delivery.
# Resend API key and a from-address on a domain verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Observability (optional; nothing is reported without a DSN)
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Dokploy-only
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://tavi:tavi@postgres:5432/tavi